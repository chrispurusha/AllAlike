#!/bin/zsh

# To run: ./do-uncrustify
#
# Formats this project's sources. SynthLib is formatted from its own repo.

setopt null_glob

for dir in src plugin tools; do
    if [[ ! -d $dir ]]; then
        echo "skipping $dir - not found"
        continue
    fi

    files=($dir/*.h $dir/*.c $dir/*.cpp $dir/*.mm)
    files=(${files:#src/tiWaves.c})        # generated data, not code
    files=(${files:#src/tiWavetables.c})

    if (( ${#files} == 0 )); then
        echo "skipping $dir - no sources"
        continue
    fi

    echo "uncrustify: $dir (${#files} files)"
    uncrustify -c uncrustify.cfg --no-backup $files
done
